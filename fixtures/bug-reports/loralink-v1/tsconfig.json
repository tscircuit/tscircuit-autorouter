{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun",
      "tscircuit"
    ],
    "baseUrl": "../../..",
    "paths": {
      "lib/*": [
        "lib/*"
      ]
    }
  },
  "include": [
    "*.tsx",
    "imports/*.tsx"
  ]
}
