{
  "name": "@tscircuit/tiny-hypergraph-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:wasm && npm run build:adapter",
    "test": "npm run build:adapter && node --test tests/*.test.mjs",
    "build:adapter": "tsc -p tsconfig.json",
    "typecheck": "npm run build:adapter && tsc -p tsconfig.types.json",
    "build:wasm": "node scripts/build.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": "./pkg/tiny_hypergraph_wasm_bg.wasm"
  },
  "files": [
    "dist",
    "pkg",
    "ts",
    "README.md"
  ],
  "dependencies": {
    "@tscircuit/hypergraph": "0.0.71",
    "graphics-debug": "0.0.99"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
