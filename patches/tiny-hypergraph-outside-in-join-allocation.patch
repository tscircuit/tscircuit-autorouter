+    if (
+      getOwnString(port, "portId") === undefined ||
+      firstRegionId === undefined ||
+      secondRegionId === undefined
+    ) return undefined
+    let firstNeighbors = pairs.get(firstRegionId)
+    if (!firstNeighbors) {
+      firstNeighbors = new Set()
+      pairs.set(firstRegionId, firstNeighbors)
+    }
+    firstNeighbors.add(secondRegionId)
+    let secondNeighbors = pairs.get(secondRegionId)
+    if (!secondNeighbors) {
+      secondNeighbors = new Set()
+      pairs.set(secondRegionId, secondNeighbors)
+    }
+    secondNeighbors.add(firstRegionId)
+  }
+  return pairs
