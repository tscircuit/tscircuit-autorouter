+const getSharedRegionPairs = (
+  graph: SerializedHyperGraph,
+  connections: NonNullable<SerializedHyperGraph["connections"]>,
+): Map<string, Set<string>> | undefined => {
+  const portsDescriptor = Object.getOwnPropertyDescriptor(graph, "ports")
+  if (!portsDescriptor || !("value" in portsDescriptor)) return undefined
+  const ports: unknown = portsDescriptor.value
+  if (!isPlainArray(ports) || !isPlainArray(connections)) return undefined
+
+  for (let index = 0; index < connections.length; index++) {
+    const descriptor = Object.getOwnPropertyDescriptor(connections, index)
+    if (!descriptor || !("value" in descriptor)) return undefined
