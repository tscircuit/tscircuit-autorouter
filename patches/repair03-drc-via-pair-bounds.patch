+// Circle distance is stable in this range; the DRC epsilon exceeds coordinate
+// rounding. Unsafe/coercible geometry retains the entire original via scan.
+const canFilterViaPairBounds = (vias: Via[], clearance: number): boolean => {
+  if (!Number.isFinite(clearance) || clearance < 0 || clearance > 1e9) {
+    return false
+  }
+  for (const via of vias) {
+    if (
+      !Number.isFinite(via.x) ||
+      !Number.isFinite(via.y) ||
+      !Number.isFinite(via.diameter) ||
+      Math.abs(via.x) > 1e9 ||
+      Math.abs(via.y) > 1e9 ||
+      via.diameter < 0 ||
+      via.diameter > 1e9
+    ) {
+      return false
+    }
+  }
+  return true
+}
