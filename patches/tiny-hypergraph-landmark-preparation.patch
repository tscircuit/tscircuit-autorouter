+import { BaseSolver, SolverRuntime } from "@tscircuit/solver-utils"
+
+export type LandmarkDistanceInput = {
+  portX: ArrayLike<number>
+  portY: ArrayLike<number>
+  incidentPortRegion: number[][]
+  regionIncidentPorts: number[][]
+  landmark: number
+  start?: number
+  regionNetId?: Int32Array
+  reserved?: Int32Array
+  net?: number
+}
+
+/** Exact shortest geometric distances on the relaxed, undirected port graph. */
+export class LandmarkDistancePreparationSolver extends BaseSolver {
+  static readonly solverName = "LandmarkDistancePreparationSolver"
+  private output?: Float64Array
+  constructor(private readonly input: LandmarkDistanceInput) { super() }
+  override _step(): void {
+    const { portX, portY, incidentPortRegion, regionIncidentPorts, landmark } = this.input
+    const count = portX.length
+    const distances = new Float64Array(count).fill(Infinity)
+    const heap = new Int32Array(count)
+    const positions = new Int32Array(count).fill(-1)
+    const closed = new Uint8Array(count)
+    let size = 1
+    heap[0] = landmark
+    positions[landmark] = 0
+    distances[landmark] = 0
+    let stopDistance = Infinity
+    while (size > 0) {
+      if (distances[heap[0]!]! > stopDistance) break
+      const port = heap[0]!
+      positions[port] = -1
+      closed[port] = 1
+      if (port === this.input.start) stopDistance = Math.max(1, distances[port]! * 1.5)
+      const last = heap[--size]!
+      if (size > 0) {
+        let index = 0
+        while (index * 2 + 1 < size) {
+          let child = index * 2 + 1
+          if (child + 1 < size && distances[heap[child + 1]!]! < distances[heap[child]!]!) child++
+          if (distances[last]! <= distances[heap[child]!]!) break
+          heap[index] = heap[child]!
+          positions[heap[index]!] = index
+          index = child
+        }
+        heap[index] = last
+        positions[last] = index
+      }
+      const base = distances[port]!
+      for (const region of incidentPortRegion[port]!) {
+        const owner = this.input.regionNetId?.[region] ?? -1
+        if (owner !== -1 && owner !== this.input.net) continue
+        for (const next of regionIncidentPorts[region]!) {
+          if (closed[next]) continue
+          const owner = this.input.reserved?.[next] ?? -1
+          if (owner !== -1 && owner !== this.input.net) continue
+          const dx = portX[port]! - portX[next]!
+          const dy = portY[port]! - portY[next]!
+          const candidate = base + Math.sqrt(dx * dx + dy * dy)
+          if (candidate >= distances[next]!) continue
+          distances[next] = candidate
+          let index = positions[next]!
+          if (index === -1) index = size++
+          while (index > 0) {
+            const parent = (index - 1) >>> 1
+            if (distances[heap[parent]!]! <= candidate) break
+            heap[index] = heap[parent]!
+            positions[heap[index]!] = index
+            index = parent
+          }
+          heap[index] = next
+          positions[next] = index
+        }
+      }
+    }
+    for (let index = 0; index < count; index++) if (!closed[index]) distances[index] = Infinity
+    this.output = distances
+    this.solved = true
+  }
+  getOutput(): Float64Array {
+    if (!this.output) throw new Error("Landmark distances are not prepared")
+    return this.output
+  }
+}
+SolverRuntime.registerSolver(LandmarkDistancePreparationSolver)
