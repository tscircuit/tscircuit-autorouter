@@ -0,0 +1,23 @@
+import { BaseSolver, SolverRuntime } from "@tscircuit/solver-utils"
+import { LandmarkDistancePreparationSolver, type LandmarkDistanceInput } from "./LandmarkDistancePreparationSolver"
+export type GoalDistancePreparationInput = Omit<LandmarkDistanceInput, "landmark" | "start" | "net"> & {
+  routes: Array<{ route: number; landmark: number; start: number; net: number }>
+}
+export class GoalDistancePreparationSolver extends BaseSolver {
+  static readonly solverName = "GoalDistancePreparationSolver"
+  private output?: Array<[number, Float64Array]>
+  constructor(private readonly input: GoalDistancePreparationInput) { super() }
+  override _step(): void {
+    this.output = this.input.routes.map((route): [number, Float64Array] => {
+      const solver = new LandmarkDistancePreparationSolver({ ...this.input, ...route })
+      solver.solve()
+      return [route.route, solver.getOutput()]
+    })
+    this.solved = true
+  }
+  getOutput(): Array<[number, Float64Array]> {
+    if (!this.output) throw new Error("Goal distances have not been prepared")
+    return this.output
+  }
+}
+SolverRuntime.registerSolver(GoalDistancePreparationSolver)
