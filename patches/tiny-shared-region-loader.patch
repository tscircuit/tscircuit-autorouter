+  Symbol.species,
+)?.get
+const hasNativeArrayMethods =
+  Function.prototype.toString.call(nativeArrayMap).includes("[native code]") &&
+  Function.prototype.toString.call(nativeArrayFilter).includes("[native code]")
+
+const isPlainArray = (value: unknown): value is unknown[] =>
+  hasNativeArrayMethods &&
+  Array.isArray(value) &&
+  Object.getPrototypeOf(value) === Array.prototype &&
+  !Object.hasOwn(value, "map") &&
+  !Object.hasOwn(value, "filter") &&
+  !Object.hasOwn(value, "constructor") &&
+  Object.getOwnPropertyDescriptor(Array.prototype, "map")?.value ===
