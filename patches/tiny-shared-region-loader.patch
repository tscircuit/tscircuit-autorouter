+    nativeArraySpecies
+
+const getOwnString = (value: object, key: string): string | undefined => {
+  const descriptor = Object.getOwnPropertyDescriptor(value, key)
+  return descriptor && "value" in descriptor && typeof descriptor.value === "string"
+    ? descriptor.value
+    : undefined
+}
+
+// Only replace repeated scans of plain records. Accessors and custom array
+// methods keep their original calls, including reads of matching port IDs.
+const getSharedRegionPairs = (
+  graph: SerializedHyperGraph,
+  connections: NonNullable<SerializedHyperGraph["connections"]>,
+): Map<string, Set<string>> | undefined => {
+  const portsDescriptor = Object.getOwnPropertyDescriptor(graph, "ports")
+  if (!portsDescriptor || !("value" in portsDescriptor)) return undefined
+  const ports: unknown = portsDescriptor.value
+  if (!isPlainArray(ports) || !isPlainArray(connections)) return undefined
+
+  for (let index = 0; index < connections.length; index++) {
+    const descriptor = Object.getOwnPropertyDescriptor(connections, index)
+    if (!descriptor || !("value" in descriptor)) return undefined
+    const connection = descriptor.value
+    if (!connection || typeof connection !== "object") return undefined
+    const prototype = Object.getPrototypeOf(connection)
+    if (prototype !== Object.prototype && prototype !== null) return undefined
+    if (
+      getOwnString(connection, "connectionId") === undefined ||
+      getOwnString(connection, "startRegionId") === undefined ||
+      getOwnString(connection, "endRegionId") === undefined
+    ) return undefined
+  }
+
+  const pairs = new Map<string, Set<string>>()
+  for (let index = 0; index < ports.length; index++) {
+    const descriptor = Object.getOwnPropertyDescriptor(ports, index)
+    if (!descriptor || !("value" in descriptor)) return undefined
+    const port = descriptor.value
+    if (!port || typeof port !== "object") return undefined
+    const prototype = Object.getPrototypeOf(port)
+    if (prototype !== Object.prototype && prototype !== null) return undefined
+    const firstRegionId = getOwnString(port, "region1Id")
+    const secondRegionId = getOwnString(port, "region2Id")
+    if (
+      getOwnString(port, "portId") === undefined ||
+      firstRegionId === undefined ||
+      secondRegionId === undefined
+    ) return undefined
+    let firstNeighbors = pairs.get(firstRegionId)
+    if (!firstNeighbors) {
+      firstNeighbors = new Set()
+      pairs.set(firstRegionId, firstNeighbors)
+    }
+    firstNeighbors.add(secondRegionId)
+    let secondNeighbors = pairs.get(secondRegionId)
+    if (!secondNeighbors) {
+      secondNeighbors = new Set()
+      pairs.set(secondRegionId, secondNeighbors)
+    }
+    secondNeighbors.add(firstRegionId)
+  }
+  return pairs
+}
