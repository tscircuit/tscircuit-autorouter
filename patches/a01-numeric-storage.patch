+  private configureSearchIndexStorage(): void {
+    // Every expanded grid cell admits at most eight lateral moves plus one
+    // move to each other layer. This bounds every search node ID and parent.
+    const admissionBound = 1 + this.layers * this.planeSize * (this.layers + 7)
+    const integerGrid =
+      Number.isInteger(this.rows) && this.rows > 0 &&
+      Number.isInteger(this.cols) && this.cols > 0 &&
+      Number.isInteger(this.layers) && this.layers > 0 &&
+      Number.isSafeInteger(admissionBound) && admissionBound <= 0x7fffffff
+    const integerEndpoints = this.unsolvedSegs.every((segment) =>
+      Number.isInteger(segment.startZ) && segment.startZ >= 0 && segment.startZ < this.layers &&
+      Number.isInteger(segment.endZ) && segment.endZ >= 0 && segment.endZ < this.layers &&
+      Number.isInteger(segment.startRow) && segment.startRow >= 0 && segment.startRow < this.rows &&
+      Number.isInteger(segment.endRow) && segment.endRow >= 0 && segment.endRow < this.rows &&
+      Number.isInteger(segment.startCol) && segment.startCol >= 0 && segment.startCol < this.cols &&
+      Number.isInteger(segment.endCol) && segment.endCol >= 0 && segment.endCol < this.cols
+    )
+    // Layer indices and clamped grid coordinates are nonnegative integers;
+    // parent IDs are -1 or already-admitted node IDs. Exceptional constructor
+    // geometry keeps the original Float64 representation and search behavior.
+    this.searchIndexArrayConstructor = integerGrid && integerEndpoints
+      ? Int32Array
+      : Float64Array
+    this.nodeZ = new this.searchIndexArrayConstructor(0)
+    this.nodeRow = new this.searchIndexArrayConstructor(0)
+    this.nodeCol = new this.searchIndexArrayConstructor(0)
+    this.nodeParent = new this.searchIndexArrayConstructor(0)
+  }
+
+  private resetSearchNodes(): void {
+    // Numeric slots have no references. Release every live ripped chain before
+    // recycling node IDs for the next connection, while retaining capacity.
+    if (this.nodeG.length > MAX_RETAINED_SEARCH_NODES) {
+      // Large searches must not retain their peak allocation while portfolio
+      // candidates wait for the rest of the board to finish.
+      this.nodeZ = new this.searchIndexArrayConstructor(0)
+      this.nodeRow = new this.searchIndexArrayConstructor(0)
+      this.nodeCol = new this.searchIndexArrayConstructor(0)
+      this.nodeG = new Float64Array(0)
+      this.nodeParent = new this.searchIndexArrayConstructor(0)
+      this.nodeRipped = []
+    } else {
+      this.nodeRipped.fill(null, 0, this.nodeCount)
+    }
+    this.nodeCount = 0
+  }
+
+  private appendSearchNode(
+    z: number,
+    row: number,
+    col: number,
+    g: number,
+    parentIdx: number,
+    ripped: RippedNode | null,
+  ): number {
+    const index = this.nodeCount
+    if (index === this.nodeG.length) {
+      const capacity = Math.max(256, this.nodeG.length * 2)
+      const zValues = new this.searchIndexArrayConstructor(capacity)
+      const rowValues = new this.searchIndexArrayConstructor(capacity)
+      const colValues = new this.searchIndexArrayConstructor(capacity)
+      const gValues = new Float64Array(capacity)
+      const parentValues = new this.searchIndexArrayConstructor(capacity)
+      zValues.set(this.nodeZ)
+      rowValues.set(this.nodeRow)
+      colValues.set(this.nodeCol)
+      gValues.set(this.nodeG)
+      parentValues.set(this.nodeParent)
+      this.nodeZ = zValues
+      this.nodeRow = rowValues
+      this.nodeCol = colValues
+      this.nodeG = gValues
+      this.nodeParent = parentValues
+      this.nodeRipped.length = capacity
+    }
+    this.nodeZ[index] = z
+    this.nodeRow[index] = row
+    this.nodeCol[index] = col
+    this.nodeG[index] = g
+    this.nodeParent[index] = parentIdx
+    this.nodeRipped[index] = ripped
+    this.nodeCount = index + 1
+    return index
+  }
