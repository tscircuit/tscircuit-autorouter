+++ b/lib/create-branch-via.ts
@@ -0,0 +1,158 @@
+import { getCopperLayerNames } from "@tscircuit/fanout-solver"
+import { boardSegmentIsClear } from "./board-outline"
+import { effectiveCarrierLayers } from "./effective-carrier-layers"
+import { generatedEscapeHolesConflict } from "./expanded-signal-sites"
+import type {
+  Connection,
+  Obstacle,
+  SimpleRouteJson,
+  Terminal,
+  Trace,
+} from "./types"
+import { clearanceToCopper, fixedCopper } from "./vector-scene"
+
+/** Add a through via at an existing, owned wire vertex without changing the trunk. */
+export function createBranchVia({
+  input,
+  connection,
+  attachments,
+  width,
+}: {
+  input: SimpleRouteJson
+  connection: Connection
+  attachments: Terminal[]
+  width: number
+}): { point: Terminal; trace: Trace } | undefined {
+  const layers = getCopperLayerNames(input.layerCount)
+  const diameter = input.minViaPadDiameter ?? 0.3
+  const hole = input.minViaHoleDiameter ?? 0.15
+  if (
+    ![diameter, hole].every((n) => Number.isFinite(n) && n > 0) ||
+    hole > diameter
+  )
+    return
+  const rules = input as SimpleRouteJson & {
+    minViaEdgeToPadEdgeClearance?: number
+    minTraceToHoleEdgeClearance?: number
+    minPlatedHoleDrillEdgeToDrillEdgeClearance?: number
+  }
+  const clearance =
+    input.minTraceToPadEdgeClearance ?? input.defaultObstacleMargin ?? 0.075
+  const padClearance = rules.minViaEdgeToPadEdgeClearance ?? clearance
+  const traceHoleClearance = rules.minTraceToHoleEdgeClearance ?? clearance
+  const drillClearance = Math.max(
+    input.minViaHoleEdgeToViaHoleEdgeClearance ?? 0.1,
+    rules.minPlatedHoleDrillEdgeToDrillEdgeClearance ?? 0,
+  )
+  if (
+    ![clearance, padClearance, traceHoleClearance, drillClearance].every(
+      (n) => Number.isFinite(n) && n >= 0,
+    )
+  )
+    return
+  const owners = new Set(
+    [
+      connection.name,
+      connection.source_trace_id,
+      ...connection.pointsToConnect.flatMap((point) => [
+        point.pcb_port_id,
+        point.pointId,
+      ]),
+    ].filter((owner): owner is string => !!owner),
+  )
+  const copper = fixedCopper({ ...input, obstacles: [] }).filter(
+    (item) => !item.owners.some((owner) => owners.has(owner)),
+  )
+  const pads = input.obstacles.flatMap((obstacle) => {
+    const drilled = obstacle as Obstacle & {
+      isNonPlatedHole?: boolean
+      circuitJsonMetadata?: { pcb_plated_hole_id?: string }
+    }
+    const isHole =
+      drilled.isNonPlatedHole ||
+      !!drilled.circuitJsonMetadata?.pcb_plated_hole_id
+    const owned = obstacle.connectedTo.some((owner) => owners.has(owner))
+    if (owned && input.allowViaInPad && !isHole) return []
+    let margin = owned ? hole / 2 + 1e-5 : diameter / 2 + padClearance
+    // SRJ exposes the plated-hole copper envelope, not its drill dimensions.
+    // Keeping the new drill clear of that envelope is conservative.
+    if (isHole) margin = Math.max(margin, hole / 2 + drillClearance)
+    if (drilled.isNonPlatedHole)
+      margin = Math.max(margin, diameter / 2 + traceHoleClearance)
+    return [
+      {
+        copper: fixedCopper({
+          ...input,
+          traces: [],
+          obstacles: [{ ...obstacle, layers: [layers[0]] }],
+        })[0],
+        margin,
+      },
+    ]
+  })
+  const carrierLayers = effectiveCarrierLayers(input, connection)
+  for (const point of attachments) {
+    if (point.layers?.length) continue
+    const carrier = carrierLayers.find((layer) => layer !== point.layer)
+    if (
+      !carrier ||
+      !boardSegmentIsClear({
+        input,
+        start: point,
+        end: point,
+        copperRadiusMm: diameter / 2,
+      })
+    )
+      continue
+    if (
+      pads.some(
+        ({ copper, margin }) =>
+          clearanceToCopper(point, point, copper) < margin - 1e-8,
+      )
+    )
+      continue
+    if (
+      copper.some((item) => {
+        const gap = clearanceToCopper(point, point, item)
+        return (
+          gap < diameter / 2 + clearance - 1e-8 ||
+          // Point copper represents via lands; drill-to-drill spacing is checked below.
+          (item.a !== item.b && gap < hole / 2 + traceHoleClearance - 1e-8)
+        )
+      })
+    )
+      continue
+    const trace: Trace = {
+      type: "pcb_trace",
+      pcb_trace_id: `branch_via_${connection.name}`,
+      connection_name: connection.name,
+      source_trace_id: connection.source_trace_id ?? connection.name,
+      route: [
+        {
+          x: point.x,
+          y: point.y,
+          route_type: "wire",
+          layer: point.layer,
+          width,
+        },
+        {
+          x: point.x,
+          y: point.y,
+          route_type: "via",
+          from_layer: point.layer,
+          to_layer: carrier,
+          layers,
+          via_diameter: diameter,
+          via_hole_diameter: hole,
+        },
+        { x: point.x, y: point.y, route_type: "wire", layer: carrier, width },
+      ],
+    }
+    if (generatedEscapeHolesConflict(input, [trace], input.traces ?? []))
+      continue
+    return {
+      point: { x: point.x, y: point.y, layer: point.layer, layers },
+      trace,
+    }
+  }
+}
