+/** Prefer paths that leave future package exits open, including after shortening. */
+export function getPendingExitPathCost({
+  input,
+  connection,
+  width,
+  pendingExits = [],
+}: PendingExitPathCostOptions): (path: Point[]) => number {
+  if (!pendingExits.length) return length
+  const scene = new VectorScene(input, connection, width, pendingExits)
+  return (path: Point[]): number =>
+    path
