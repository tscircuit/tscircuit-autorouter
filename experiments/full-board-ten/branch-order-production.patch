+  // Keep the existing largest-package primary. Equal-size secondary packages
+  // share one mean distance so individual nets do not split the package order.
+  const packageDistances = new Map<
+    ComponentId,
+    Map<ComponentId, PackageDistance>
+  >()
+  for (const { terminals } of connectionsWithPads) {
+    const primary = terminals[0]
+    if (terminals.length <= 2 || !primary?.componentId) continue
+    const distances =
+      packageDistances.get(primary.componentId) ??
+      new Map<ComponentId, PackageDistance>()
+    for (const target of terminals.slice(1)) {
+      if (!target.componentId) continue
+      const distance = distances.get(target.componentId) ?? {
+        totalMm: 0,
+        terminalCount: 0,
+      }
+      distance.totalMm += Math.hypot(
+        target.terminal.x - primary.terminal.x,
+        target.terminal.y - primary.terminal.y,
+      )
+      distance.terminalCount++
+      distances.set(target.componentId, distance)
+    }
+    packageDistances.set(primary.componentId, distances)
