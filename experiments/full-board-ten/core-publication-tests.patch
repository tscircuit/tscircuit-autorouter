diff --git a/tests/features/autoroutingphase-continues-after-failure.test.tsx b/tests/features/autoroutingphase-continues-after-failure.test.tsx
new file mode 100644
index 0000000..a7515d8
--- /dev/null
+++ b/tests/features/autoroutingphase-continues-after-failure.test.tsx
@@ -0,0 +1,87 @@
+import { expect, spyOn, test } from "bun:test"
+import { AutoroutingPipelineSolver9_PreloadedTraceGraph } from "@tscircuit/capacity-autorouter"
+import type { AutoroutingErrorEvent, AutoroutingStartEvent } from "lib/events"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("a failed phase preserves accepted copper and allows an independent phase to route", async () => {
+  const { circuit } = getTestFixture()
+  const startedPhases: AutoroutingStartEvent["routingPhaseIndex"][] = []
+  const routingErrors: AutoroutingErrorEvent[] = []
+  circuit.on("autorouting:start", (event) => {
+    startedPhases.push(event.routingPhaseIndex)
+  })
+  circuit.on("autorouting:error", (event) => routingErrors.push(event))
+  circuit.add(
+    <board width={20} height={18} schematicDisabled routeRemaining={false}>
+      <resistor name="R1" resistance="1k" footprint="0402" pcbX={-4} pcbY={5} />
+      <resistor name="R2" resistance="1k" footprint="0402" pcbX={4} pcbY={5} />
+      <resistor name="R3" resistance="1k" footprint="0402" pcbX={-4} pcbY={0} />
+      <resistor name="R4" resistance="1k" footprint="0402" pcbX={4} pcbY={0} />
+      <resistor
+        name="R5"
+        resistance="1k"
+        footprint="0402"
+        pcbX={-4}
+        pcbY={-5}
+      />
+      <resistor name="R6" resistance="1k" footprint="0402" pcbX={4} pcbY={-5} />
+      <autoroutingphase phaseIndex={2} name="Accepted phase" />
+      <autoroutingphase phaseIndex={9} name="Failed phase" />
+      <autoroutingphase phaseIndex={15} name="Independent phase" />
+      <trace name="ACCEPTED" from="R1.2" to="R2.1" routingPhaseIndex={2} />
+      <trace name="FAILED" from="R3.2" to="R4.1" routingPhaseIndex={9} />
+      <trace name="INDEPENDENT" from="R5.2" to="R6.1" routingPhaseIndex={15} />
+      <pcbnotetext pcbY={7} fontSize={0.6} text="Accepted copper remains" />
+      <pcbnotetext pcbY={2} fontSize={0.6} text="Failed phase stays unrouted" />
+      <pcbnotetext
+        pcbY={-7}
+        fontSize={0.6}
+        text="Independent phase can route"
+      />
+    </board>,
+  )
+
+  const step = AutoroutingPipelineSolver9_PreloadedTraceGraph.prototype.step
+  const stepSpy = spyOn(
+    AutoroutingPipelineSolver9_PreloadedTraceGraph.prototype,
+    "step",
+  ).mockImplementation(function (
+    this: AutoroutingPipelineSolver9_PreloadedTraceGraph,
+  ) {
+    // Exercise the built-in failure event only for the middle phase.
+    if (startedPhases.at(-1) === 9) this.MAX_ITERATIONS = 0
+    step.call(this)
+  })
+  try {
+    await circuit.renderUntilSettled()
+    await expect(circuit).toMatchPcbSnapshot(import.meta.path, {
+      shouldDrawErrors: false,
+      shouldDrawRatsNest: true,
+    })
+    expect(startedPhases).toEqual([2, 9, 15])
+    expect(routingErrors).toHaveLength(1)
+    expect(routingErrors[0]).toMatchObject({
+      routingPhaseIndex: 9,
+      _actualRoutingPhaseOrderIndex: 1,
+    })
+    const acceptedTrace = circuit.db.source_trace
+      .list()
+      .find((trace) => trace.name === "ACCEPTED")!
+    const independentTrace = circuit.db.source_trace
+      .list()
+      .find((trace) => trace.name === "INDEPENDENT")!
+    expect(
+      new Set(
+        circuit.db.pcb_trace.list().map((trace) => trace.source_trace_id),
+      ),
+    ).toEqual(
+      new Set([
+        acceptedTrace.source_trace_id,
+        independentTrace.source_trace_id,
+      ]),
+    )
+    expect(circuit.db.pcb_autorouting_error.list()).toHaveLength(1)
+  } finally {
+    stepSpy.mockRestore()
+  }
+})
diff --git a/tests/features/autoroutingphase-stops-after-unexpected-error.test.tsx b/tests/features/autoroutingphase-stops-after-unexpected-error.test.tsx
new file mode 100644
index 0000000..a442965
--- /dev/null
+++ b/tests/features/autoroutingphase-stops-after-unexpected-error.test.tsx
@@ -0,0 +1,78 @@
+import { expect, spyOn, test } from "bun:test"
+import { AutoroutingPipelineSolver9_PreloadedTraceGraph } from "@tscircuit/capacity-autorouter"
+import type { AutoroutingStartEvent } from "lib/events"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("an unexpected solver exception remains the terminal routing error", async () => {
+  const { circuit } = getTestFixture()
+  const startedPhases: AutoroutingStartEvent["routingPhaseIndex"][] = []
+  let terminalRoutingError: string | undefined
+  circuit.on("autorouting:start", (event) => {
+    startedPhases.push(event.routingPhaseIndex)
+  })
+  circuit.on("asyncEffect:end", (event) => {
+    if (event.effectName === "autorouting") terminalRoutingError = event.error
+  })
+  circuit.add(
+    <board width={20} height={18} schematicDisabled routeRemaining={false}>
+      <resistor name="R1" resistance="1k" footprint="0402" pcbX={-4} pcbY={5} />
+      <resistor name="R2" resistance="1k" footprint="0402" pcbX={4} pcbY={5} />
+      <resistor name="R3" resistance="1k" footprint="0402" pcbX={-4} pcbY={0} />
+      <resistor name="R4" resistance="1k" footprint="0402" pcbX={4} pcbY={0} />
+      <resistor
+        name="R5"
+        resistance="1k"
+        footprint="0402"
+        pcbX={-4}
+        pcbY={-5}
+      />
+      <resistor name="R6" resistance="1k" footprint="0402" pcbX={4} pcbY={-5} />
+      <autoroutingphase phaseIndex={2} name="Accepted phase" />
+      <autoroutingphase phaseIndex={9} name="Expected solver failure" />
+      <autoroutingphase phaseIndex={15} name="Unexpected exception" />
+      <autoroutingphase phaseIndex={21} name="Must not start" />
+      <trace from="R1.2" to="R2.1" routingPhaseIndex={2} />
+      <trace from="R3.2" to="R4.1" routingPhaseIndex={9} />
+      <trace from="R5.2" to="R6.1" routingPhaseIndex={15} />
+      <trace from="R1.1" to="R2.2" routingPhaseIndex={21} />
+      <pcbnotetext pcbY={7} fontSize={0.6} text="Accepted copper remains" />
+      <pcbnotetext pcbY={2} fontSize={0.6} text="Expected solver failure" />
+      <pcbnotetext
+        pcbY={-7}
+        fontSize={0.6}
+        text="Unexpected exception surfaces"
+      />
+    </board>,
+  )
+
+  const step = AutoroutingPipelineSolver9_PreloadedTraceGraph.prototype.step
+  const stepSpy = spyOn(
+    AutoroutingPipelineSolver9_PreloadedTraceGraph.prototype,
+    "step",
+  ).mockImplementation(function (
+    this: AutoroutingPipelineSolver9_PreloadedTraceGraph,
+  ) {
+    if (startedPhases.at(-1) === 9) this.MAX_ITERATIONS = 0
+    if (startedPhases.at(-1) === 15) {
+      throw new Error("Unexpected solver exception")
+    }
+    step.call(this)
+  })
+  try {
+    await circuit.renderUntilSettled()
+    expect(startedPhases).toEqual([2, 9, 15])
+    expect(terminalRoutingError).toContain("Unexpected solver exception")
+    const routingErrors = circuit.db.pcb_autorouting_error.list()
+    expect(routingErrors).toHaveLength(2)
+    expect(routingErrors[0].pcb_error_id).not.toBe(
+      routingErrors[1].pcb_error_id,
+    )
+    expect(circuit.db.pcb_trace.list()).toHaveLength(1)
+    await expect(circuit).toMatchPcbSnapshot(import.meta.path, {
+      shouldDrawErrors: false,
+      shouldDrawRatsNest: true,
+    })
+  } finally {
+    stepSpy.mockRestore()
+  }
+})
