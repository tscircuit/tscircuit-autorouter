index 000000000..a4c310379
--- /dev/null
+++ b/lib/solvers/PortPointPathingSolver/tinyhypergraph/getPreloadedTraceVias.ts
@@ -0,0 +1,41 @@
+import type { SimplifiedPcbTrace } from "lib/types"
+
+export type PreloadedTraceVia = {
+  traceId: string
+  routePosition: number
+  center: { x: number; y: number }
+  diameter: number
+  z1: number
+  z2: number
+}
+
+export const getPreloadedTraceVias = ({
+  traces,
+  layerCount,
+  defaultViaDiameter,
+  allowBlindAndBuriedVias,
+}: {
+  traces: SimplifiedPcbTrace[]
+  layerCount: number
+  defaultViaDiameter: number
+  allowBlindAndBuriedVias?: boolean
+}): PreloadedTraceVia[] => {
+  // This allocation certificate applies to through vias. Blind/buried boards
+  // can use existing conductors with different physical layer spans.
+  if (allowBlindAndBuriedVias === true) return []
+  const vias: PreloadedTraceVia[] = []
+  for (const trace of traces) {
+    for (const [routePosition, point] of trace.route.entries()) {
+      if (point.route_type !== "via") continue
+      vias.push({
+        traceId: trace.pcb_trace_id,
+        routePosition,
+        center: { x: point.x, y: point.y },
+        diameter: point.via_diameter ?? defaultViaDiameter,
+        z1: 0,
+        z2: layerCount - 1,
+      })
+    }
+  }
+  return vias
+}
