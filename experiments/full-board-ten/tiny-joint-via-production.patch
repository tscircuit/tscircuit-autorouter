+const distanceToViaRegion = (
+  point: { x: number; y: number },
+  region: ViaRegion,
+): number => {
+  const dx = Math.max(region.minX - point.x, 0, point.x - region.maxX)
+  const dy = Math.max(region.minY - point.y, 0, point.y - region.maxY)
+  return Math.sqrt(dx * dx + dy * dy)
