{
  "name": "srj18-hex-oct-experiment",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --timeout 9999999 tests",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun build src/galleryApp.ts --target browser --format iife --outfile gallery.js && bun build src/gridRouter.ts --target bun --outdir work/build",
    "gallery": "python3 build_gallery.py",
    "route": "bun src/gridRouter.ts",
    "check:gallery": "bun scripts/checkGallery.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "playwright": "1.64.0",
    "typescript": "5.9.3"
  }
}
